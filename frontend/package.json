{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:stable": "vite build --mode stable",
    "build:canary": "vite build --mode canary",
    "lint": "eslint . --max-warnings 0 && npm run lint:css",
    "lint:css": "stylelint --config ../stylelint.config.cjs \"src/**/*.css\" --ignore-pattern \"src/bootstrap-theme.css\" --ignore-pattern \"src/common-theme.css\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "predeploy": "npm run build",
    "deploy": "npx gh-pages -d dist",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "bootstrap": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "monocart-reporter": "^2.12.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.4.1"
  }
}
